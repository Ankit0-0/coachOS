DATABASE_URL="your db url"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
# Google client ID(s) used to verify id_tokens. Comma-separate web + iOS +
# Android client IDs so tokens minted for any platform pass verification.
GOOGLE_CLIENT_ID="your-google-web-client-id,your-google-ios-client-id,your-google-android-client-id"
PORT=4000
CLIENT_URL="http://localhost:8081"
NODE_ENV="development"
LOG_LEVEL="debug"
# Password reset email delivery (Resend). Leave RESEND_API_KEY empty in
# development — the reset code is logged to the server console instead of
# being emailed. Production must set a real key or resets cannot complete.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="CoachOS <onboarding@resend.dev>"