# ------------------------------------------------------------------
# CoachOS backend. Copy to .env for local development; in production set
# these in the host's environment (Render) instead. Never commit real values.
# ------------------------------------------------------------------

# --- Database -------------------------------------------------------
DATABASE_URL="postgresql://coachos:coachos@localhost:5432/coachos"
# Max connections in the pg pool. Managed plans cap total connections (Aiven
# free tier: 20), so keep this small; 5 per instance leaves room for
# migrations, a second instance during a deploy, and psql sessions.
DB_POOL_MAX=5

# --- Auth -----------------------------------------------------------
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
# Google client ID(s) used to verify id_tokens. Comma-separate web + iOS +
# Android client IDs so tokens minted for any platform pass verification.
GOOGLE_CLIENT_ID="your-google-web-client-id,your-google-ios-client-id,your-google-android-client-id"

# --- Server ---------------------------------------------------------
PORT=4000
NODE_ENV="development"
LOG_LEVEL="debug"
# Browser origins allowed through CORS, comma-separated, exact match with no
# trailing slash, e.g. "https://admin.example.com,https://app.example.com".
# Native apps send no Origin and are always allowed; in development any
# localhost port is allowed as well.
CLIENT_URL="http://localhost:8081"

# --- Password reset email (Resend) ----------------------------------
# Leave RESEND_API_KEY empty in development: the reset code is logged to the
# server console instead of emailed. Production must set a real key or resets
# cannot complete.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="CoachOS <onboarding@resend.dev>"

# --- S3 image uploads (progress photos, meal photos, avatars) ------
# Leave empty in development, CI and tests: the server boots fine without
# them and only the upload endpoints fail, with a clear error. Production
# needs all four.
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""
