generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  COACH
  CLIENT
  ADMIN
}

/// Only meaningful for COACH users; null on CLIENT and ADMIN.
enum CoachApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlanType {
  DIET
  WORKOUT
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  name      String
  role      Role
  createdAt DateTime @default(now())

  /// Set to PENDING when a coach registers, and left null for CLIENT and
  /// ADMIN, for whom approval is meaningless rather than merely unset.
  coachApprovalStatus CoachApprovalStatus?

  accounts Account[]

  plansCreated        Plan[]           @relation("PlanCreator")
  assignmentsGiven    PlanAssignment[] @relation("AssignedByCoach")
  assignmentsReceived PlanAssignment[] @relation("AssignedToClient")
  weightEntries       WeightEntry[]    @relation("ClientWeightEntries")

  coachProfile  CoachProfile?
  clientProfile ClientProfile?

  sentInvites     CoachClientInvite[] @relation("SentInvites")
  receivedInvites CoachClientInvite[] @relation("ReceivedInvites")

  coachSubscriptions  Subscription[] @relation("CoachSubscriptions")
  clientSubscriptions Subscription[] @relation("ClientSubscriptions")

  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model CoachClientInvite {
  id String @id @default(cuid())

  coachId String
  coach   User   @relation("SentInvites", fields: [coachId], references: [id], onDelete: Cascade)

  clientEmail String
  clientId    String?
  client      User?   @relation("ReceivedInvites", fields: [clientId], references: [id], onDelete: SetNull)

  status      InviteStatus @default(PENDING)
  token       String       @unique @default(cuid())

  /// Chosen by the coach when inviting. Used once, on acceptance, to compute
  /// the first subscription's endDate. Null means an open-ended relationship
  /// with no subscription record at all.
  durationMonths Int?

  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  @@index([coachId])
  @@index([clientEmail])
  @@index([clientId])
}

/// A commercial record of a paid period, layered on top of the coach-client
/// relationship rather than governing it. Access is still decided solely by an
/// ACCEPTED CoachClientInvite: an expired subscription is shown in the UI, it
/// does not revoke anything.
model Subscription {
  id String @id @default(cuid())

  coachId String
  coach   User   @relation("CoachSubscriptions", fields: [coachId], references: [id], onDelete: Cascade)

  clientId String
  client   User   @relation("ClientSubscriptions", fields: [clientId], references: [id], onDelete: Cascade)

  startDate DateTime           @db.Date
  endDate   DateTime           @db.Date
  status    SubscriptionStatus @default(ACTIVE)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coachId])
  @@index([clientId])
  @@index([status])
}

model Account {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Plan {
  id          String   @id @default(cuid())
  type        PlanType
  title       String
  description String?
  content     Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String?
  createdBy   User?    @relation("PlanCreator", fields: [createdById], references: [id])

  assignments PlanAssignment[]

  @@index([createdById])
  @@index([type])
}

model PlanAssignment {
  id     String @id @default(cuid())
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  coachId String
  coach   User   @relation("AssignedByCoach", fields: [coachId], references: [id])

  clientId String
  client   User   @relation("AssignedToClient", fields: [clientId], references: [id])

  status     AssignmentStatus @default(ACTIVE)
  assignedAt DateTime         @default(now())
  startDate  DateTime?
  endDate    DateTime?
  updatedAt  DateTime         @updatedAt

  checkIns CheckIn[]

  @@index([clientId])
  @@index([coachId])
}

model CoachProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio             String?
  specialties     String[]
  yearsExperience Int?
  phone           String?
}

model ClientProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  heightCm Int?
  weightKg Float?
  goals    String?
}

model CheckIn {
  id           String         @id @default(cuid())
  assignmentId String
  assignment   PlanAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  date             DateTime @db.Date
  completedItemIds String[]
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([assignmentId, date])
  @@index([assignmentId])
}

model WeightEntry {
  id       String @id @default(cuid())
  clientId String
  client   User   @relation("ClientWeightEntries", fields: [clientId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date
  weightKg  Float
  photoUrl  String?
  createdAt DateTime @default(now())

  @@unique([clientId, date])
  @@index([clientId])
}