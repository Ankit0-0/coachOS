# ------------------------------------------------------------------
# Coach OS coaches app — environment variables (example)
# Copy this file to `.env` and adjust the values for your machine.
# Only variables prefixed with EXPO_PUBLIC_ are exposed to the app.
# ------------------------------------------------------------------

# Backend API base URL (the Express server mounts all feature routes under /v1)
# - iOS simulator / web  -> http://localhost:4000/v1
# - Android emulator     -> http://10.0.2.2:4000/v1  (localhost is auto-rewritten in code)
# - Physical device      -> http://<your-lan-ip>:4000/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/v1

# Google OAuth
# Client IDs for each platform your app runs on. The backend verifies the
# Google id_token against its GOOGLE_CLIENT_ID list, so every ID used here
# must also be present (comma-separated) in the backend's .env.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id

# --- Error reporting (Sentry) ---------------------------------------
# Optional. Leave blank and Sentry never starts, which is the normal state for
# local development — anything that isn't a URL counts as "no DSN".
# The real DSN for each app lives in eas.json, per build profile, so builds
# report and your machine doesn't. A DSN is write-only and is baked into the
# bundle anyway (every EXPO_PUBLIC_ value is), so it is not a secret.
EXPO_PUBLIC_SENTRY_DSN=
# Which environment an event is tagged with. eas.json sets "preview" or
# "production"; unset means "development".
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
#
# Source map upload happens on the EAS build machine, not in the app, so these
# are NOT app variables and do not belong in this file:
#   SENTRY_ORG, SENTRY_PROJECT        -> eas.json, per build profile
#   SENTRY_AUTH_TOKEN                 -> an EAS environment variable with
#                                        secret visibility; never in a file
#   SENTRY_DISABLE_AUTO_UPLOAD=true   -> currently in eas.json; delete it once
#                                        the three above are set, and stack
#                                        traces stop arriving minified
