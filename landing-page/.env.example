# ------------------------------------------------------------------
# CoachOS landing page — environment variables (example)
# Copy to `.env.local` for local development. Only NEXT_PUBLIC_ values
# reach the browser, and all of them are read at build time: changing one
# needs a redeploy.
# ------------------------------------------------------------------

# The backend's base URL, including /v1. The landing page talks to the
# backend only through POST /v1/early-access.
#   local       -> http://localhost:4000/v1
#   production  -> https://coachos-fxor.onrender.com/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# The two web apps, opened in a new tab from the hero's "Open the web app".
# The button stays hidden until both are real URLs — unset or these
# example.com placeholders hide it.
NEXT_PUBLIC_COACH_APP_URL=https://coach.example.com
NEXT_PUBLIC_CLIENT_APP_URL=https://app.example.com
